{
  "name": "fallback-forge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "sidecar:install": "npm --prefix sidecar install",
    "sidecar:test": "npm --prefix sidecar test",
    "gifski:test": "cargo test --manifest-path gifski-worker/Cargo.toml",
    "gifski:build": "node scripts/build-gifski-worker.mjs",
    "check": "npm run build && npm run gifski:test && npm run sidecar:test && npm run server:test",
    "server": "node server/index.cjs",
    "server:test": "node --test server/test/*.test.cjs"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/storage-blob": "^12.34.0",
    "@base-ui/react": "^1.7.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.7",
    "lucide-react": "^1.33.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
