{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fallback Forge",
  "version": "0.1.0",
  "identifier": "com.bannerforge.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecar:build && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run sidecar:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fallback Forge",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/banner-forge-sidecar",
      "binaries/gifski-worker"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["dmg", "app"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
